{
  "name": "vocabs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "H5 spaced-repetition app for the Academic Collocation List (ACL) and Academic Formulas List (AFL)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:artifact": "npm run build:single && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
